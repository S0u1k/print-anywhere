# ========================================================
# PocketPrint Bridge — Environment Configuration Template
# Copy to .env or configure in Vercel / Cloud Environment
# ========================================================

# Relay Server Port & Public URL
PORT=5000
NODE_ENV=production
PUBLIC_APP_URL=https://pocketprint-bridge.vercel.app
RELAY_PUBLIC_URL=https://pocketprint-bridge.vercel.app

# JWT Secret for Session & Download Token Security (min 32 chars)
JWT_SECRET=your_secure_32_character_jwt_secret_key_here

# --------------------------------------------------------
# Firebase Client Configuration (Public Web Frontend)
# --------------------------------------------------------
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_DATABASE_URL=https://your_project_id-default-rtdb.firebaseio.com
VITE_SOCKET_URL=http://localhost:5000

# --------------------------------------------------------
# Firebase Admin SDK Configuration (Server-side / Vercel Functions)
# Option A: Single JSON String
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
#
# Option B: Individual Variables
# --------------------------------------------------------
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://your_project_id-default-rtdb.firebaseio.com
FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
